# HuddleScope Raspberry Pi production configuration (issue #158 / HS-PORT-02)
#
# Raspberry Pi hosts are repo-less: they ingest to Turso and export is run
# from GitHub Actions. This config uses the turso backend and absolute paths
# under /opt/huddlescope (the documented RPi install location).
#
# Copy to /opt/huddlescope/huddlescope.env and fill in the Turso credentials.
# Run `scripts/install-config.sh rpi <this-file>` to install it with safe
# permissions.
#
# Precedence (highest wins): CLI flags > environment > this file > defaults.
# All paths must be ABSOLUTE (relative paths are rejected in production).

# --- Environment ---
HSC_ENV=production
HSC_STORAGE_BACKEND=turso

# --- Turso (required in production; shared with the VPS and GitHub Actions) ---
#TURSO_DATABASE_URL=libsql://your-database-url.example
#TURSO_AUTH_TOKEN=your-turso-auth-token

# --- Execution origin (issue #159 / HS-PORT-03) ---
# Identifies this host in the dashboard.
HSC_RUNNER_ORIGIN=raspberry

# --- Portable site-data control (issue #158 / HS-PORT-02) ---
# The RPi is repo-less: it never writes web/data. Leave at "auto" (production
# -> skip). The export is run from GitHub Actions, which sets
# HSC_PUBLISH_SITE_DATA=true to keep the committed files fresh.
HSC_PUBLISH_SITE_DATA=auto

# --- Absolute paths (RPi install layout) ---
# The binary and config live under /opt/huddlescope. Set absolute paths so the
# binary works regardless of the working directory it is invoked from.
HSC_SOURCES_FILE=/opt/huddlescope/sources.yaml
HSC_TEAMS_FILE=/opt/huddlescope/teams.yaml
HSC_DATA_DIR=/opt/huddlescope/data
HSC_HEARTBEAT_FILE=/opt/huddlescope/web/data/heartbeat.json
HSC_FEEDS_FILE=/opt/huddlescope/web/data/feeds.json
HSC_HUGO_CONTENT_DIR=/opt/huddlescope/site/content
# Only relevant if you switch to sqlite-file; ignored when backend=turso.
HSC_STORAGE_PATH=/opt/huddlescope/storage.db

# --- Optional: JSON run log ---
HSC_JSON_LOG=false
