# HuddleScope production deployment configuration (issue #158 / HS-PORT-02)
#
# Copy to /etc/huddlescope/deploy.env (or your chosen location) and fill in the
# Turso credentials. Run `scripts/install-config.sh deploy <this-file>` to
# install it with safe permissions.
#
# Precedence (highest wins): CLI flags > environment > this file > defaults.
# All paths must be ABSOLUTE when set (relative paths are rejected for input
# files in all envs and for output paths in production).

# --- Environment ---
# Production requires a shared/persistent storage backend (turso or sqlite-file).
HSC_ENV=production
HSC_STORAGE_BACKEND=turso

# --- Turso (required in production) ---
#TURSO_DATABASE_URL=libsql://your-database-url.example
#TURSO_AUTH_TOKEN=your-turso-auth-token

# --- Execution origin (issue #159 / HS-PORT-03) ---
# Recorded on ingest run rows so the dashboard can show which host ran ingest.
# Use "vps" or "raspberry" as appropriate for the host running this deploy.
HSC_RUNNER_ORIGIN=vps

# --- Portable site-data control (issue #158 / HS-PORT-02) ---
# On a repo-less host (VPS/Raspberry), leave at "auto": in production this
# skips writing web/data files, so ingest never creates web/data. The run
# indicators are persisted to Turso instead.
# Set to "true" only if this host has a git repo and you want to commit the
# site-data files (e.g., a CI runner).
HSC_PUBLISH_SITE_DATA=auto

# --- Optional: opt-in JSON run log ---
# Single-line JSON log (time, run_id, origin, command, status, exit_code,
# counters). Never includes tokens or DSNs. Useful for structured log ingestion.
HSC_JSON_LOG=false

# --- Optional: absolute paths (only set if not using the repo layout) ---
# When this deploy does NOT sit inside the huddlescope repo, set absolute
# paths for the input files and output locations:
#HSC_SOURCES_FILE=/etc/huddlescope/sources.yaml
#HSC_TEAMS_FILE=/etc/huddlescope/teams.yaml
#HSC_DATA_DIR=/var/lib/huddlescope/data
#HSC_HEARTBEAT_FILE=/var/lib/huddlescope/web/data/heartbeat.json
#HSC_FEEDS_FILE=/var/lib/huddlescope/web/data/feeds.json
#HSC_HUGO_CONTENT_DIR=/var/lib/huddlescope/site/content
#HSC_STORAGE_PATH=/var/lib/huddlescope/storage.db
#
# NOTE: HSC_STORAGE_PATH is only relevant when HSC_STORAGE_BACKEND=sqlite-file.
# When using turso, the data lives in the Turso database, not a local file.
