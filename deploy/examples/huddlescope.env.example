# HuddleScope systemd deployment configuration (issue #162 / HS-PORT-06)
#
# This is the environment file consumed by the systemd service unit via
# EnvironmentFile=/etc/huddlescope/huddlescope.env.
#
# Copy to /etc/huddlescope/huddlescope.env and fill in the Turso credentials:
#   sudo install -m 0600 huddlescope.env.example /etc/huddlescope/huddlescope.env
#   sudo chown huddlescope:huddlescope /etc/huddlescope/huddlescope.env
#
# The installed file MUST be mode 0600 and owned by the non-root service user
# (huddlescope:huddlescope) so the Turso auth token is not readable by anyone
# else. Never run the service as root.
#
# Precedence (highest wins): CLI flags > environment > this file > defaults.
# All paths must be ABSOLUTE (relative paths are rejected in production).

# --- Environment ---
HSC_ENV=production
HSC_STORAGE_BACKEND=turso

# --- Turso (required in production; shared with the VPS, RPi, and GitHub Actions) ---
# Uncomment and fill in with your real values. These are secrets: the installed
# file is 0600 huddlescope:huddlescope so they are not world-readable.
#TURSO_DATABASE_URL=libsql://your-database-url.example
#TURSO_AUTH_TOKEN=your-turso-auth-token

# --- Execution origin (issue #159 / HS-PORT-03) ---
# Identifies this host in the dashboard. Use "vps" for a VPS host, or change
# to "raspberry" for a Raspberry Pi host.
HSC_RUNNER_ORIGIN=vps

# --- Portable site-data control (issue #158 / HS-PORT-02) ---
# This host is repo-less: it never writes web/data. Leave at "auto" (production
# -> skip). GitHub Actions runs export and keeps the committed files fresh.
HSC_PUBLISH_SITE_DATA=auto

# --- Optional: JSON run log ---
# Single-line JSON log (time, run_id, origin, command, status, exit_code,
# counters). Never includes tokens or DSNs. Useful for structured log ingestion.
HSC_JSON_LOG=false

# --- Absolute paths (systemd install layout) ---
# The service runs with WorkingDirectory=/var/lib/huddlescope and reads its
# env from /etc/huddlescope/huddlescope.env. Set absolute paths to the input
# files so the binary works regardless of working directory.
HSC_SOURCES_FILE=/etc/huddlescope/sources.yaml
HSC_TEAMS_FILE=/etc/huddlescope/teams.yaml
HSC_DATA_DIR=/var/lib/huddlescope/data
HSC_HEARTBEAT_FILE=/var/lib/huddlescope/web/data/heartbeat.json
HSC_FEEDS_FILE=/var/lib/huddlescope/web/data/feeds.json
HSC_HUGO_CONTENT_DIR=/var/lib/huddlescope/site/content
# Only relevant if you switch to sqlite-file; ignored when backend=turso.
HSC_STORAGE_PATH=/var/lib/huddlescope/storage.db
