# Build artifacts
dist/
coverage.out
/huddlescope

# Legacy entrypoints (deprecated; replaced by unified huddlescope)
/ingest
/export
/heartbeat

# Hugo site build artifacts
web/public/
web/resources/
web/hugo_stats.json

# Site test artifacts + local dev output (HS-056)
web/.site-test-tmp/
web/site-test.log
web/fixtures/dev/

# Issue #247 / PUB-01: generated Hugo data is NOT tracked in Git. The
# production news snapshot and the deployed manifest are generated by
# `export run` / `publish manifest put` and live in the workspace (and, for the
# manifest, in Turso). Only web/fixtures/* (the deterministic demo sample) and
# web/content/stories/_index.md (hand-authored) are tracked. Generated story
# pages written by the story publisher are ignored; _index.md is un-ignored.
web/data/homepage.json
web/data/feeds.json
web/data/heartbeat.json
web/data/deployed.json
web/data/*.tmp
web/content/stories/*.md
!web/content/stories/_index.md
web/.hugo_build.lock
web/site-test-run-2.log

# Local secrets
.env
# Operator-provided compose env file (see compose.yaml env_file); the committed
# placeholder-only example lives at deploy/examples/huddlescope.env.example.
/huddlescope.env

# Go cache
# go.sum is required for dependency verification and CI
go.work
go.work.sum

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
*.exe
*.out

# Node scheduler
scheduler/node_modules/
scheduler/.wrangler/

# Stale backups
*.bak
