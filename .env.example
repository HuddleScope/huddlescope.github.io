# HuddleScope environment variables
# Copy this file to .env and set real values only for your local development.

# Configuration file path (optional; if omitted, env vars are used)
# Use the -config flag (e.g., ./dist/huddlescope -config .env) to load settings
# HSC_CONFIG_FILE is not supported (use -config flag instead)

# Log level: debug, info, warn, error (default: info)
HSC_LOG_LEVEL=info

# User agent for HTTP requests (include version and contact)
HSC_USER_AGENT=huddlescope-local/0.1 (+dev)

# Request timeout for external fetches (duration, e.g., 30s)
HSC_REQUEST_TIMEOUT=30s

# Hugo base URL for exports (do not include trailing slash)
HSC_HUGO_BASE_URL=https://huddlescope.github.io/

# Environment: dev (default) or production
# Production mode requires storage backend, Turso URL, and token
#HSC_ENV=dev

# Lookback window for incremental processing (duration, e.g., 24h)
# Entries older than (now - lookback) are skipped
# Default: 24h
#HSC_LOOKBACK=24h

# Similarity threshold for article clustering (0 < threshold <= 1)
# Lower values allow more articles to be grouped together
# Default: 0.50
#HSC_SIMILARITY_THRESHOLD=0.50

# Temporal window for clustering (duration, e.g., 48h)
# Articles outside this window from the earliest article in a group are not merged
# Default: 48h
#HSC_CLUSTER_WINDOW=48h

# Storage backend (memory for local, turso for production, sqlite-file for file-based storage)
#HSC_STORAGE_BACKEND=memory
#TURSO_DATABASE_URL=
#TURSO_AUTH_TOKEN=

# Execution origin recorded on ingest run rows (issue #159 / HS-PORT-03).
# Values: raspberry, vps, github-backup (CI sets this), or any [a-z0-9-] label.
# Default: local
#HSC_RUNNER_ORIGIN=local

# Portable deployment (issue #158 / HS-PORT-02).
# When setting these to paths, use ABSOLUTE paths (e.g., /etc/huddlescope/
# sources.yaml). Relative paths are rejected for input files in all envs and
# for output paths in production. See docs/portable-deployment.md.
#
# Absolute path to a YAML sources file (overrides the default conf/sources.yaml).
# A CLI --sources-file flag wins over this env var, which wins over the --config file.
#HSC_SOURCES_FILE=/etc/huddlescope/sources.yaml
#
# Absolute path to a YAML teams file (overrides the default conf/teams.yaml).
# A CLI --teams-file flag wins over this env var, which wins over the --config file.
#HSC_TEAMS_FILE=/etc/huddlescope/teams.yaml
#
# Site-data publish control. Values: auto (default), true, false.
#   auto  = dev/test writes web/data files, production skips them
#   true  = always write web/data files (GitHub Actions sets this)
#   false = never write web/data files
# A repo-less VPS/Raspberry host leaves this at auto (production -> skip), so
# ingest-to-Turso never creates web/data. See docs/portable-deployment.md.
#HSC_PUBLISH_SITE_DATA=auto
#
# Opt-in single-line JSON run log (time, run_id, origin, command, status,
# exit_code, counters). Never includes tokens or DSNs. Default: false.
#HSC_JSON_LOG=false

# Retention (HS-065 / issue #120)
# Hot tables (articles, stories, ranking_snapshots) are archived automatically
# into *_archive mirrors; expiring rows are exported to a portable package
# (archive/retention/ in CI) before archiving. Disable with false.
#HSC_RETENTION_ENABLED=true
# Retention window in days (default: 90)
#HSC_RETENTION_DAYS=90

# Sources
# HSC_SOURCES (deprecated, use HSC_SOURCES_FILE instead)
# Environment variable format: id,name,url[,interval][,priority][,enabled][,publication][,language][,timeout][,license][,accept-use];...
# Example: HSC_SOURCES=nfl-news,NFL News,http://example.com,300
#
# HSC_SOURCES_FILE
# Path to YAML file containing sources configuration.
# Default: conf/sources.yaml
# Format:
#   sources:
#     - id: source-id
#       name: Display Name
#       url: https://example.com/feed
#       category: national
#       enabled: true
#       verification: confirmed_xml
#       publication: Publisher Name
#       priority: 1
#       language: en
#       timeout: 30
#       license: RSS syndication permitted
#       acceptable_use: allowed
#
# If HSC_SOURCES_FILE is not specified, defaults to conf/sources.yaml.
# If the file is missing or contains no sources, no sources are configured
# and the ingest command exits with an error (no built-in defaults remain).
# HSC_SOURCES env var takes precedence over HSC_SOURCES_FILE.
# HSC_SOURCES=

# Hugo snapshot output paths (HS-056)
# These control where the huddlescope binary writes its JSON output.
# Production (refresh-news) sets none of these, so the committed defaults
# (web/data/heartbeat.json, web/data/feeds.json, web/data/homepage.json)
# apply.
#
# Local development: point ingest at the gitignored fixture dir so a local
# run never dirties the tracked web/data/heartbeat.json:
#HSC_HEARTBEAT_FILE=web/fixtures/dev/heartbeat.json
#HSC_FEEDS_FILE=web/fixtures/dev/feeds.json
#
# Homepage snapshot output:
#HSC_DATA_DIR=web/data
#HSC_DATA_FILE=homepage.json
#
# Representative sample content for `make site-watch` (untracked copies are
# placed in web/data and web/content/stories; remove them with `rm` when done):
#   make site-seed
