# HuddleScope environment variables
# Copy this file to .env and set real values only for your local development.

# Configuration file path (optional; if omitted, env vars are used)
#HSC_CONFIG_FILE=

# Log level: debug, info, warn, error (default: info)
HSC_LOG_LEVEL=info

# User agent for HTTP requests (include version and contact)
HSC_USER_AGENT=huddlescope-local/0.1 (+dev)

# Request timeout for external fetches (duration, e.g., 30s)
HSC_REQUEST_TIMEOUT=30s

# Hugo base URL for exports (do not include trailing slash)
HSC_HUGO_BASE_URL=https://huddlescope.github.io/

# Environment: dev (default) or production
# Production mode requires storage backend, Turso URL, and token
#HSC_ENV=dev

# Lookback window for incremental processing (duration, e.g., 24h)
# Entries older than (now - lookback) are skipped
# Default: 24h
#HSC_LOOKBACK=24h

# Storage backend (memory for local, turso for production, sqlite-file for file-based storage)
#HSC_STORAGE_BACKEND=memory
#TURSO_DATABASE_URL=
#TURSO_AUTH_TOKEN=

# Sources
# HSC_SOURCES (deprecated, use HSC_SOURCES_FILE instead)
# Environment variable format: id,name,url[,interval][,priority][,enabled][,publication][,language][,timeout][,license][,accept-use];...
# Example: HSC_SOURCES=nfl-news,NFL News,http://example.com,300
#
# HSC_SOURCES_FILE
# Path to YAML file containing sources configuration.
# Default: conf/sources.yaml
# Format:
#   sources:
#     - id: source-id
#       name: Display Name
#       url: https://example.com/feed
#       category: national
#       enabled: true
#       verification: confirmed_xml
#       publication: Publisher Name
#       priority: 1
#       language: en
#       timeout: 30
#       license: RSS syndication permitted
#       acceptable_use: allowed
#
# If HSC_SOURCES_FILE is not specified, defaults to conf/sources.yaml.
# If HSC_SOURCES_FILE is empty or file not found, falls back to built-in defaults.
# HSC_SOURCES env var takes precedence over HSC_SOURCES_FILE.
# HSC_SOURCES=