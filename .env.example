# HuddleScope environment variables
# Copy this file to .env and set real values only for your local development.

# Configuration file path (optional; if omitted, env vars are used)
#HSC_CONFIG_FILE=

# Log level: debug, info, warn, error (default: info)
HSC_LOG_LEVEL=info

# User agent for HTTP requests (include version and contact)
HSC_USER_AGENT=huddlescope-local/0.1 (+dev)

# Request timeout for external fetches (duration, e.g., 30s)
HSC_REQUEST_TIMEOUT=30s

# Hugo base URL for exports (do not include trailing slash)
HSC_HUGO_BASE_URL=https://huddlescope.github.io/

# Environment: dev (default) or production
# Production mode requires storage backend, Turso URL, and token
#HSC_ENV=dev

# Storage backend (memory for local, turso for production, sqlite-file for file-based storage)
#HSC_STORAGE_BACKEND=memory
#TURSO_DATABASE_URL=
#TURSO_AUTH_TOKEN=

# Sources (RSS feed list)
# Format: id,name,url[,interval];id,name,url[,interval];...
# Example: nfl-news,NFL News,http://example.com,300;nfl-updates,NFL Updates,http://other.com
#HSC_SOURCES=